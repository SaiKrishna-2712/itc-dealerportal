{
  "_version": "1.90.0",
  "sap.app": {
    "id": "com.itc.dealerportal",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.34.0",
      "toolsId": "a5fa6253-307c-49bf-9ac9-e78c35120f05"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.tnt": {},
        "sap.f": {},
        "sap.ui.layout": {},
        "sap.ui.comp": {},
        "sap.ui.table": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.itc.dealerportal.i18n.i18n"
        }
      },
      "mAppViewModel": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "mainContents",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.itc.dealerportal.view",
        "async": true,
        "viewPath": "com.itc.dealerportal.view"
      },
      "routes": [
        {
          "name": "RouteHome",
          "pattern": ":?query:",
          "target": [
            "TargetHome"
          ]
        },
        {
          "name": "RoutePaymentOverview",
          "pattern": "paymentoverview",
          "target": [
            "TargetPaymentOverView"
          ]
        },
        {
          "name": "RoutePayments",
          "pattern": "payments",
          "target": [
            "TargetPayments"
          ]
        },
        {
          "name": "RouteInvoiceStatus",
          "pattern": "invoicestatus",
          "target": [
            "TargetInvoiceStatus"
          ]
        }
      ],
      "targets": {
        "TargetHome": {
          "id": "idHomePage",
          "name": "Home"
        },
        "TargetPaymentOverView": {
          "id": "idPymntOVPage",
          "name": "PaymentOverview"
        },
        "TargetPayments": {
          "id": "idPaymentsPage",
          "name": "Payments"
        },
        "TargetInvoiceStatus": {
          "id": "idInvoiceStatusPage",
          "name": "InvoiceStatus"
        }
      }
    },
    "rootView": {
      "viewName": "com.itc.dealerportal.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}